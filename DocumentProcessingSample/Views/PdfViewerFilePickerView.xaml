<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             x:Class="DocumentProcessingSample.Views.PdfViewerFilePickerView">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#eee8f4">
        <Label Grid.Row="0" 
               Text="Select a PDF File" 
               FontSize="14" 
               FontAttributes="Bold"
               Padding="10"
               TextColor="#1f1f1f"/>

        <listView:SfListView Grid.Row="1" 
                            x:Name="FileListView" 
                            ItemTapped="FileListView_ItemTapped"
                             ItemSpacing="02"
                             ItemSize="40"
                            >
            <listView:SfListView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout Padding="05">
                        <Label Text="📄" VerticalOptions="Center"/>
                        <Label Text="{Binding .}" 
                               VerticalOptions="Center" 
                               VerticalTextAlignment="Center"
                               />
                    </HorizontalStackLayout>
                </DataTemplate>
            </listView:SfListView.ItemTemplate>
        </listView:SfListView>
    </Grid>
</ContentView>
