<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.PdfViewer;assembly=Syncfusion.Maui.PdfViewer"
             xmlns:local="clr-namespace:DocumentProcessingSample.Views"
             x:Class="DocumentProcessingSample.Views.PdfViewerSamplesPage"
             Title="PDF Viewer Samples">
    <Grid RowDefinitions="*">
        
        <syncfusion:SfPdfViewer x:Name="PdfViewer" />
        
        <!-- File Picker Popup -->
        <Frame x:Name="FilePickerFrame"
               IsVisible="False"
               CornerRadius="02"
               HasShadow="True"
               BorderColor="#D2D2D2"
               BackgroundColor="#eee8f4"
               Margin="{OnPlatform WinUI='04,50,04,50', MacCatalyst='04,50,04,50'}"
               Padding="0"
               VerticalOptions="{OnPlatform WinUI=Start, MacCatalyst=Start, Android=Fill, iOS=Fill}"
               HorizontalOptions="{OnPlatform WinUI=Start, MacCatalyst=Start, Android=Fill, iOS=Fill}"
               WidthRequest="{OnPlatform WinUI=250, MacCatalyst=250}"
               HeightRequest="{OnPlatform WinUI=310, MacCatalyst=310}">
            <local:PdfViewerFilePickerView x:Name="FilePickerView"/>
        </Frame>
    </Grid>
</ContentPage>
