<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DocumentProcessingSample.Views.PowerPointSamplesPage"
             Title="PowerPoint Samples">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
            <Frame BackgroundColor="#F0F4F8" CornerRadius="12" Padding="24" HasShadow="True" BorderColor="#D0D7DE">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label Text="📑 Syncfusion Presentation"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#D24726"
                           HorizontalOptions="Center" />
                    <Label Text="Syncfusion Essential Presentation is a .NET PowerPoint library to create, read, and edit PowerPoint presentations (PPTX) with rich graphics."
                           FontSize="14"
                           TextColor="#555555"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Features showcase: Slide Transitions, Animations, SmartArt, Charts, Shapes, Tables, and PowerPoint to PDF/Image conversion."
                           FontSize="13"
                           TextColor="#777777"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
